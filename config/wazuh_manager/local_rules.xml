<!--
  Wazuh Local Rules — Correlation & Detection Rules
  Project: SIEM Wazuh + ELK Deployment
  Author: Security Engineer
  Description: 8 custom correlation rules for advanced threat detection
-->

<group name="local,syslog,sshd,">

  <!-- RULE 1: SSH Brute Force Detection (Correlation) -->
  <rule id="100001" level="10" frequency="6" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>SSH Brute Force Attack Detected: Multiple failed login attempts from $(srcip)</description>
    <mitre>
      <id>T1110</id>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_11.4,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- RULE 2: Successful Brute Force (Failed followed by Success) -->
  <rule id="100002" level="12" frequency="8" timeframe="180">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <if_matched_sid>5715</if_matched_sid>
    <same_source_ip />
    <description>Possible Successful SSH Brute Force: Successful login after multiple failures from $(srcip) user $(dstuser)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,pci_dss_10.2.2,pci_dss_10.2.5,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>

<group name="windows,powershell,">

  <!-- RULE 3: Suspicious PowerShell Activity -->
  <rule id="100003" level="8">
    <if_sid>60009,60010</if_sid>
    <field name="win.eventdata.commandLine">-enc|-encodedcommand|IEX|Invoke-Expression|DownloadString|Net.WebClient|Start-Process|FromBase64String|bitsadmin|certutil|regsvr32|rundll32</field>
    <description>Suspicious PowerShell Command Detected on $(win.system.computer): $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
      <id>T1105</id>
    </mitre>
    <group>windows_powershell,pci_dss_10.2.7,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,tsc_CC6.1,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- RULE 4: PowerShell Obfuscation / AMSI Bypass Attempt -->
  <rule id="100004" level="10" frequency="3" timeframe="300">
    <if_matched_sid>100003</if_matched_sid>
    <same_source_ip />
    <description>PowerShell Obfuscation Pattern Detected — Possible AMSI Bypass or Malware Execution on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1562.001</id>
    </mitre>
    <group>windows_powershell,malware,pci_dss_10.2.7,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,tsc_CC6.1,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>

<group name="syscheck,ossec,">

  <!-- RULE 5: Critical File Modification — /etc/passwd -->
  <rule id="100005" level="11">
    <if_sid>550</if_sid>
    <field name="file">/etc/passwd</field>
    <description>Critical System File Modified: /etc/passwd changed on $(agent.name) by $(user). Possible unauthorized user addition or privilege escalation.</description>
    <mitre>
      <id>T1098</id>
      <id>T1136</id>
      <id>T1548</id>
    </mitre>
    <group>syscheck,pci_dss_10.2.5,pci_dss_10.5.2,pci_dss_11.4,gdpr_IV_30.1.g,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- RULE 6: Mass User Account Creation (Correlation across multiple sources) -->
  <rule id="100006" level="10" frequency="4" timeframe="300">
    <if_matched_sid>5902</if_matched_sid>
    <same_source_ip />
    <description>Mass User Account Creation Detected: $(frequency) new accounts created within 5 minutes on $(agent.name). Possible lateral movement preparation or persistence.</description>
    <mitre>
      <id>T1136</id>
      <id>T1136.001</id>
      <id>T1098</id>
    </mitre>
    <group>adduser,pci_dss_10.2.5,pci_dss_10.2.7,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_AC.2,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- RULE 7: Shadow File Modification (Companion to /etc/passwd) -->
  <rule id="100007" level="11">
    <if_sid>550</if_sid>
    <field name="file">/etc/shadow</field>
    <description>Critical System File Modified: /etc/shadow changed on $(agent.name). Possible password hash tampering or unauthorized privilege escalation.</description>
    <mitre>
      <id>T1003</id>
      <id>T1003.008</id>
    </mitre>
    <group>syscheck,pci_dss_10.2.5,pci_dss_10.5.2,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>

<group name="syslog,linux,">

  <!-- RULE 8: Sudo Privilege Escalation Anomaly -->
  <rule id="100008" level="8" frequency="5" timeframe="60">
    <if_matched_sid>5402</if_matched_sid>
    <same_source_ip />
    <description>Unusual Sudo Activity: $(frequency) sudo commands executed rapidly by $(dstuser) on $(agent.name). Possible privilege escalation or lateral movement.</description>
    <mitre>
      <id>T1548</id>
      <id>T1548.003</id>
    </mitre>
    <group>pci_dss_10.2.5,pci_dss_10.2.7,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_AC.6,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>
